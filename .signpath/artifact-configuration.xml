<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Winston.
  The GitHub upload-artifact action wraps winston.exe in a ZIP, hence the zip-file root element.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="winston.exe">
      <authenticode-sign hash-algorithm="sha256"/>
    </pe-file>
  </zip-file>
</artifact-configuration>
